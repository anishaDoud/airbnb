<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Registered</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="auth-page">
    <div class="auth-shell">
      <div class="success-card">
        <div class="success-icon">✓</div>
        <span class="eyebrow">Success</span>
        <h1><%= newHome.homeName %> is now live.</h1>
        <p>Your listing in <%= newHome.location %> has been added successfully.</p>
        <a href="/users" class="primary-btn">Go to home page</a>
      </div>
    </div>
  </body>
</html>
