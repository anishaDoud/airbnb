<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Airbnb Home</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body class="min-h-screen bg-slate-50 text-slate-800">
    <div class="page-shell">
      <header class="topbar">
        <div class="brand-wrap">
          <span class="brand-mark">A</span>
          <span class="brand-name">airbnb</span>
        </div>
        <nav class="nav-links">
          <a href="#stays">Stays</a>
          <a href="#experiences">Experiences</a>
          <a href="#hosting">Hosting</a>
          <a href="/users/store/favourites">Favourites</a>

        </nav>
        <a href="/hosts/register-home" class="action-btn">List your home</a>
      </header>

      <main class="main-content">
        <section class="hero-card">
          <div class="hero-copy">
            <span class="eyebrow">Plan your next escape</span>
            <h1>Find a place that feels like home.</h1>
            <p>
              Discover cozy stays, beautiful villas, and unique homes for every kind of trip.
            </p>
            <div class="cta-row">
              <a href="#stays" class="primary-btn">Explore stays</a>
              <a href="/hosts/register-home" class="secondary-btn">Become a host</a>
            </div>
          </div>

          <div class="hero-visual">
            <div class="visual-glow"></div>
            <div class="floating-card">
              <p>Superhost</p>
              <strong>Ocean View Villa</strong>
              <span>4.9 · 128 reviews</span>
            </div>
          </div>
        </section>

        <section id="stays" class="listing-section">
          <div class="section-heading">
            <div>
              <span class="eyebrow">Featured homes</span>
              <h2>Popular places to stay</h2>
            </div>
            <a href="/hosts/register-home" class="text-link">Add your listing</a>
          </div>

          <div class="card-grid">
            <% homes.forEach((home, index) => { %>
              <% const imageUrl = home.photourl || 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?w=800'; %>
              <article class="listing-card">
                <a href="/users/store/home-details/<%= index %>" class="card-main-link">
                  <div
                    class="listing-image image-one"
                    style="background-image: url('<%= imageUrl %>');"
                  ></div>
                  <div class="listing-body">
                    <div class="listing-meta">
                      <span class="badge">SUPERHOST</span>
                      <span class="rating">★ 4.9</span>
                    </div>
                    <h3><%= home.homeName %></h3>
                    <p><%= home.location %></p>
                  </div>
                </a>

                <div class="listing-actions">
                  <div class="price-row">
                    <strong>$<%= home.price || 180 %>/night</strong>
                    <button type="button" class="book-btn">Book</button>
                    <a href="/users/store/favourites/add?id=<%= index %>" class="favorite-btn">Favorite</a>
                  </div>
                </div>
              </article>
            <% }) %>
          </div>
        </section>
      </main>
    </div>
  </body>
</html>
